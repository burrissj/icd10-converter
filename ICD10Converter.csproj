<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ICD10Converter</AssemblyName>
    <RootNamespace>ICD10Converter</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <Product>ICD-10 Converter</Product>
    <Copyright>Copyright (c) 2026 burrissj</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- One self-contained exe: nothing to install, just double-click. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
